# Copy to .env and fill in. Never commit .env.
# Keys are futures-only and IP-allowlisted (Locked Decision 1); the startup
# check refuses a key that can withdraw.
TREND_MODE=paper
TREND_BINANCE_API_KEY=
TREND_BINANCE_API_SECRET=
# Set to the literal token below only when you intend to trade real money.
# The engine refuses --mode live without it (CARRY US-01 AC 4).
TREND_LIVE_CONFIRM=

CARRY_MODE=paper
CARRY_BINANCE_API_KEY=
CARRY_BINANCE_API_SECRET=

# Healthchecks.io free tier allows 20 checks — one per sleeve.
HEALTHCHECKS_URL_TREND=
HEALTHCHECKS_URL_CARRY=

# Litestream replica URLs (a free object-storage bucket), one path per sleeve.
TREND_REPLICA=
CARRY_REPLICA=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
